# ---------------------------------------------------------------------------
# CLIENT-SIDE (safe to expose — Vite bundles anything prefixed VITE_ into the
# browser). These are PUBLIC identifiers, not secrets. Set the same values in
# Cloudflare Pages > Settings > Environment variables for the live deploy.
# ---------------------------------------------------------------------------
VITE_APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="your-project-id"
VITE_APPWRITE_DATABASE_ID="your-database-id"
VITE_APPWRITE_BUCKET_ID="your-bucket-id"
VITE_APPWRITE_QUOTE_FUNCTION_ID="your-function-id"
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/XXXXXXXX/exec"

# ---------------------------------------------------------------------------
# SERVER-ONLY (used solely by scripts/setup-appwrite.mjs, run on your own
# machine). NEVER prefix these with VITE_, never commit real values, never
# paste them into client code — this is your Appwrite server API key.
# ---------------------------------------------------------------------------
APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="your-project-id"
APPWRITE_API_KEY="your-server-api-key"
APPWRITE_DATABASE_ID="your-database-id"
APPWRITE_BUCKET_ID="your-bucket-id"

# ---------------------------------------------------------------------------
# GROQ_API_KEY is NOT set here. It is set as an environment variable inside
# the Appwrite Function itself (Console > Functions > generate-quote >
# Settings > Variables) so it never reaches this repo or the browser.
# ---------------------------------------------------------------------------
